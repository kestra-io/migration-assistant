    "entry": {"fill": "#231a3d", "stroke": "#E2BCFF", "text": "#F4F4F6"},
    "wave": {"fill": "#1F2025", "stroke": "#45464F", "text": "#F4F4F6"},
    "reason": {"fill": "#16161A", "stroke": "#8A8E97", "text": "#F4F4F6"},
    "text_on_light_fill": "#0B0B0B",
    "text_on_dark_fill": "#FFFFFF",
    "unreachable_opacity": 0.45
  },

  "explorer": {
    "$description": "The estate explorer's canvas (a canvas cannot read CSS variables).",
    "canvas_bg": "#0B0B0B",
    "system_fill": "#16161A",
    "domain_fill_even": "#1F2025",
    "domain_fill_odd": "#16161A",
    "external_fill": "#2E2F36",
    "module_fill": "#4a6580",
    "datastore_fill": "#3d6a5a",
    "container_stroke": "#2E2F36",
    "leaf_stroke": "rgba(244, 244, 246, 0.18)",
    "selected_fill": "rgba(99, 27, 255, 0.30)",
