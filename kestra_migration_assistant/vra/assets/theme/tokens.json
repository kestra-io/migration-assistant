  },

  "font": {
    "family": "Mona Sans",
    "file": "vendor/mona-sans/MonaSansVF-opsz-wght.ttf",
    "stack": "\"Mona Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
