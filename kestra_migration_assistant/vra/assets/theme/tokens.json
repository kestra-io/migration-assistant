{
  "$description": "Every colour, font and spacing value the visuals use. Replace this file with a designer's tokens and re-run `vro.py visuals`; nothing else holds a colour. Brand values from the Kestra brand (2026-09-27). theme.py turns these into CSS custom properties, Mermaid theme variables and the explorer's canvas palette. tests/test_theme.py checks WCAG AA contrast for every text pair.",

  "brand": {
    "purple": "#631BFF",
    "ink": "#26282D",
    "body": "#5A5E67",
    "muted": "#8A8E97",
    "border": "#E2E2E7",
    "tint": "#F8F6FF",
    "near_black": "#0B0B0B",
    "lavender": "#E2BCFF",
    "white": "#FFFFFF"
  },

  "themes": {
    "dark": {
      "$description": "Default for every page on screen.",
      "bg": "#0B0B0B",
      "raised": "#16161A",
      "raised_2": "#1F2025",
      "code_bg": "#111114",
      "border": "#2E2F36",
      "border_strong": "#45464F",
      "text": "#F4F4F6",
      "text_strong": "#FFFFFF",
      "text_secondary": "#B9BAC0",
      "text_muted": "#8A8E97",
      "accent_text": "#E2BCFF",
      "link": "#E2BCFF",
      "link_hover": "#FFFFFF",
      "fill": "#631BFF",
      "on_fill": "#FFFFFF",
      "highlight": "rgba(99, 27, 255, 0.28)",
      "selection_fill": "rgba(99, 27, 255, 0.30)",
      "status_ok": "#4ade80",
      "status_wait": "#fbbf24",
      "status_bad": "#f87171"
    },
    "light": {
      "$description": "Printed reports (@media print). The brand values as given; secondary text uses body grey, because muted #8A8E97 on white is 3.4:1, below AA for body text.",
      "bg": "#FFFFFF",
      "raised": "#F8F6FF",
      "raised_2": "#F8F6FF",
      "code_bg": "#F8F6FF",
      "border": "#E2E2E7",
      "border_strong": "#8A8E97",
      "text": "#26282D",
      "text_strong": "#0B0B0B",
      "text_secondary": "#5A5E67",
      "text_muted": "#5A5E67",
      "accent_text": "#631BFF",
      "link": "#631BFF",
      "link_hover": "#26282D",
      "fill": "#631BFF",
      "on_fill": "#FFFFFF",
      "highlight": "rgba(99, 27, 255, 0.12)",
      "selection_fill": "rgba(99, 27, 255, 0.15)",
      "status_ok": "#15803d",
      "status_wait": "#a16207",
      "status_bad": "#b91c1c"
    }
  },

  "outcome": {
    "$description": "Colour-blind-safe categorical steps, ordered as triage.OUTCOMES so adjacent entries separate. Always shown with the outcome's name. Wrapper and Retire are grey on purpose: no conversion work.",
    "Retire": "#71717a",
    "Near-duplicate": "#008300",
    "Wrapper": "#94a3b8",
    "Plugin-covered library": "#3987e5",
    "Convert": "#199e70",
    "Needs owner input": "#c98500",
    "Needs a model": "#a1a1aa",
    "Manual": "#d55181",
    "Rebuild": "#9085e9"
  },
  "readiness": {"green": "#4ade80", "amber": "#fbbf24", "red": "#f87171"},
  "target": {
    "nuage-vsd": "#f472b6",
    "avi-controller": "#22d3ee",
    "vcloud-director": "#fb923c",
    "vcenter": "#818cf8",
    "ssh-host": "#e5e7eb",
    "rest-host": "#fde68a",
    "vro-platform": "#a1a1aa",
    "_default": "#8A8E97"
  },
  "unexported": "#f87171",
  "cluster_hues": {"$description": "Cluster colours are generated: golden-ratio hues at this lightness and saturation.", "lightness": 0.62, "saturation": 0.55},

  "diagram": {
    "$description": "Mermaid node classes (fill, stroke, text) on the dark theme.",
    "background": "#111114",
    "node": {"fill": "#1F2025", "stroke": "#45464F", "text": "#F4F4F6"},
    "cluster_bg": "#16161A",
    "cluster_border": "#2E2F36",
    "line": "#8A8E97",
    "task": {"fill": "#1c2533", "stroke": "#5b7fa6", "text": "#F4F4F6"},
