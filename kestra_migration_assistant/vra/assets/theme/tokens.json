    "link": {"fill": "#231a3d", "stroke": "#E2BCFF", "text": "#F4F4F6"},
    "unexported": {"fill": "#241515", "stroke": "#f87171", "text": "#f8d4d4"},
    "human": {"fill": "#2a1d38", "stroke": "#E2BCFF", "text": "#F4F4F6"},
