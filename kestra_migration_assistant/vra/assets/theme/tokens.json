  "logo": {
    "$description": "Official Kestra SVGs from the kestra-brand-logo skill, unmodified. The variant names the background.",
    "on_dark": "brand/kestra-logo-full-on-dark.svg",
    "on_light": "brand/kestra-logo-full-on-light.svg"
  }
