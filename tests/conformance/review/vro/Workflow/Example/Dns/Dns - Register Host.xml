<?xml version="1.0" encoding="UTF-8"?>
<workflow xmlns="http://vmware.com/vco/workflow" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://vmware.com/vco/workflow http://vmware.com/vco/workflow/Workflow-v4.xsd" root-name="item1" object-name="workflow:name=generic" id="e3000000-0000-4000-8000-000000000002" version="1.0.0" api-version="6.0.0" allowed-operations="vef" restartMode="1" resumeFromFailedMode="0">
  <display-name><![CDATA[Dns - Register Host]]></display-name>
  <position y="50.0" x="100.0"></position>
  <input>
    <param name="inputProperties" type="Properties">
      <description><![CDATA[event payload]]></description>
    </param>
  </input>
  <workflow-item name="item0" type="end" end-mode="0">
    <position y="45.0" x="384.5"></position>
  </workflow-item>
  <workflow-item name="item1" out-name="item0" type="task">
    <display-name><![CDATA[Dns - Register Host]]></display-name>
    <script encoded="false"><![CDATA[var util = System.getModule("com.example.dnsutil");
var dns = System.getModule("com.example.dns");
var event = util.readHostEvent(inputProperties);
var state = util.readZoneState(event.deploymentId);
var ib = util.getEndpoint("Infoblox");
for (var i = 0; i < event.hosts.length; i++) {
    dns.addHostRecord(ib, event.hosts[i].name + "." + state.zone, event.hosts[i].ip);
}]]></script>
    <in-binding>
      <bind name="inputProperties" type="Properties" export-name="inputProperties"></bind>
    </in-binding>
    <out-binding></out-binding>
    <position y="55.0" x="204.5"></position>
  </workflow-item>
  <presentation>
    <p-param name="inputProperties">
      <desc><![CDATA[inputProperties]]></desc>
    </p-param>
  </presentation>
</workflow>
